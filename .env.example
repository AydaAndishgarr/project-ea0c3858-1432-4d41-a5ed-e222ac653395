# Frontend (Vite) — safe example values only
# Mock business data stays on by default. Authentication always uses the API below.
VITE_DEMO_MODE=true

# NestJS API (must include the global prefix)
VITE_API_BASE_URL=http://localhost:3001/api/v1
# Alias accepted by the client:
# VITE_API_URL=http://localhost:3001/api/v1
