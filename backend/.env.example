# Copy this file to .env before starting the API.
# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://bms:bms@localhost:5432/bms?schema=public"

# HTTP
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_ORIGIN=http://localhost:8080

# JWT in HttpOnly cookies (not localStorage)
JWT_SECRET=replace-with-a-long-random-dev-secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=bms_access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Demo seed credentials — NOT for production
SEED_DEMO_PASSWORD=DemoPass123!
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PHONE=09120000000
SEED_ADMIN_NAME="Demo Admin"
SEED_MANAGER_EMAIL=manager@demo.local
SEED_MANAGER_PHONE=09123456789
SEED_MANAGER_NAME="Demo Manager"
SEED_RESIDENT_EMAIL=resident@demo.local
SEED_RESIDENT_PHONE=09121122334
SEED_RESIDENT_NAME="Demo Resident"
SEED_PROVIDER_EMAIL=provider@demo.local
SEED_PROVIDER_PHONE=02188997766
SEED_PROVIDER_NAME="Demo Provider"
